{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/rfp": "./src/schema/rfp.ts",
    "./schema/intel": "./src/schema/intel.ts"
  },
  "scripts": {
    "push": "pnpm run push:rfp",
    "push-force": "pnpm run push:rfp-force",
    "push:rfp": "drizzle-kit push --config ./drizzle.config.ts",
    "push:rfp-force": "node ./scripts/guarded-drizzle-push-force.mjs ./drizzle.config.ts",
    "push:intel": "drizzle-kit push --config ./drizzle.intel.config.ts",
    "push:intel-force": "node ./scripts/guarded-drizzle-push-force.mjs ./drizzle.intel.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.11"
  }
}
